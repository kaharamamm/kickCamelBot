# Kick Developer Portal → CamelBot
KICK_CLIENT_ID=your_client_id
KICK_CLIENT_SECRET=your_client_secret
KICK_REDIRECT_URI=http://localhost:3000/callback

# Must match the webhook URL you paste in Kick (public HTTPS in production)
KICK_WEBHOOK_PATH=/webhooks/kick

PORT=3000
BOT_NAME=CamelBot
COMMAND_PREFIX=!

# Google AI Studio → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional extra agents (Dashboard → AI to switch / Auto)
# Groq free+fast: https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI API (not ChatGPT Pro login): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenRouter free/paid models: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Extra Kick channel slugs (comma-separated) where CamelBot should also listen/reply.
# The bot Kick account must be able to chat there (usually /mod CamelBot).
KICK_EXTRA_CHANNELS=

# Optional: kick.com browser Cookie header (for /clear and mod slash commands).
# OAuth /login cannot run /clear — paste Cookie from DevTools or use Dashboard → Status.
# KICK_SITE_COOKIE=
# Register: https://steamcommunity.com/dev/apikey — Domain Name: localhost
STEAM_API_KEY=

# Discord (optional) — token + app client ID in .env; routes/extra always-reply users on Dashboard → Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional first-boot route seed only (never re-applied after data/discord.json exists)
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_POST_CHANNEL_ID=
# Static king Discord user ID — always gets replies; only static always-reply entry
DISCORD_KING_USER_ID=

# Discord voice (!voice join / Dashboard Voice panel):
# STT free: GROQ_API_KEY (Whisper). TTS free: Microsoft Edge voices (default).
# OpenAI TTS voices in the picker need billed API credits — ChatGPT Pro does not count.
